<Window x:Class="FleetView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FleetView"
        xmlns:settings="clr-namespace:FleetView.Settings"
        xmlns:aero2="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2"
        mc:Ignorable="d"
        Title="FleetFinder - Odyssey Engineering Material Finder"
        Icon="Assets/FleetFinderIcon.ico"
        Height="740" Width="1300" MinHeight="480" MinWidth="960"
        Background="{DynamicResource WindowBackground}" TextElement.Foreground="{DynamicResource MainText}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False">

    <!-- Custom title bar (see the "Title bar" Border below): WindowChrome keeps the native
         resize border / Aero-snap / drop shadow, but hands the top CaptionHeight strip to our
         own content instead of drawing the system caption. Only the min/max/close buttons are
         marked IsHitTestVisibleInChrome, everything else in that strip is drag-to-move and
         double-click-to-maximize for free, same as a real title bar. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Every colour in this file is {DynamicResource <role>}. The roles, their labels and
             their default colours are in Theming\ThemeRoles.cs, and ThemeService puts one brush
             per role into the application's resources at startup, which is what lets Settings
             recolour the app live. Transparent stays literal. FleetFinder.SelfTest fails if a
             colour literal or an unknown role key turns up here. -->

        <!-- Carries the view model to DataGrid columns (not in the visual tree). -->
        <local:BindingProxy x:Key="VmProxy" Data="{Binding}"/>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource GridBackground}"/>
            <Setter Property="RowBackground" Value="{DynamicResource GridRow}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAlternateRow}"/>
            <Setter Property="Foreground" Value="{DynamicResource GridText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridBorder}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLines}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource GridHeaderText}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridHeaderLines}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- No visual feedback for row selection anywhere: clicking a row (e.g. a modification)
             still updates SelectedItem bindings, it just shouldn't look different afterward.
             Overriding the SystemColors brushes (rather than DataGridRow/Cell styles directly)
             avoids disturbing the default template's alternating-row-background wiring.
             The two selected-text keys (HighlightTextBrushKey and
             InactiveSelectionHighlightTextBrushKey) used to be set here too. They now follow
             the GridText role and come from ThemeService (ThemeRoles.SystemAliases), because a
             brush defined in this file could not follow a role when it changes. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>

        <!-- Reusable centering for numeric/short columns (defined after the base header style).
             Vertically centered too, so rows that grow tall (grouped carrier results) stay tidy. -->
        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenterHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Vertically centers a left-aligned column (e.g. carrier name) in a tall grouped row. -->
        <Style x:Key="VCenterText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Horizontal breathing room from the column dividers, for the "Where to buy" results
             grid. WPF's DataGridColumn Width="Auto" sizes to the content element's own
             DesiredSize (which includes its Margin), it does NOT include DataGridCell.Padding,
             so that padding alone left text touching the dividers on narrow/fixed-width columns
             (Dist, Updated, etc.) despite being set. Margin on the content itself is what
             actually drives both the visual gap and the auto-width calculation correctly. -->
        <Style x:Key="CenterTextPadded" TargetType="TextBlock" BasedOn="{StaticResource CenterText}">
            <Setter Property="Margin" Value="7,0"/>
        </Style>
        <Style x:Key="VCenterTextPadded" TargetType="TextBlock" BasedOn="{StaticResource VCenterText}">
            <Setter Property="Margin" Value="7,0"/>
        </Style>

        <!-- The Ship Locker cards' two columns. Counts are right-aligned, header and cells alike, so
             the digits line up the way a column of numbers should; names end in an ellipsis when
             a card is narrow (a quarter of a 960 wide window) rather than being cut mid-letter. -->
        <Style x:Key="RightHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="ItemTextPadded" TargetType="TextBlock" BasedOn="{StaticResource VCenterTextPadded}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="RightTextPadded" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="7,0"/>
        </Style>

        <!-- Themed, rounded scrollbar: track is transparent, thumb rounds and lights up orange on hover. -->
        <Style x:Key="RoundedScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource ScrollbarThumb}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBorder" Background="{TemplateBinding Background}"
                                CornerRadius="5" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ScrollbarThumbHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource RoundedScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.LineLeftCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.LineRightCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource RoundedScrollBarThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom checkbox: a small rounded box matching the app's panel/border palette, filled
             with the accent color and a dark checkmark when ticked, replacing the native
             Windows checkbox glyph, same spirit as the hand-built buttons/scrollbar/title bar. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource MainText}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="3"
                                    BorderBrush="{DynamicResource CheckboxBorder}" BorderThickness="1.5" Background="{DynamicResource CheckboxBackground}"/>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                               RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource CheckboxTicked}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource CheckboxTicked}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource CheckboxHoverBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ButtonDisabledBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom title bar caption buttons (minimize/maximize/close), flat, theme-colored,
             replacing the native Windows caption glyphs entirely. Background flows through the
             TemplateBinding below, so a hover trigger just needs to set Background/Foreground on
             the Button itself; the Path/Canvas glyphs inside each button (see the title bar
             below) bind their Stroke/Fill back to those same properties via AncestorType, so
             hover color changes propagate without any template-part-name plumbing. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CaptionButtonGlyph}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptionButtonHover}"/>
                    <Setter Property="Foreground" Value="{DynamicResource CaptionButtonHoverGlyph}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Close gets the conventional red hover instead of the accent color. -->
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CloseButtonHover}"/>
                    <Setter Property="Foreground" Value="{DynamicResource CloseButtonHoverGlyph}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The settings cog: drawn like the window buttons above it (same size, same thin line,
             same hover), and lit in the selected tab's text colour while Settings is open, since
             it stands in for the Settings tab's own header. The glyph is shared with the Settings
             preview, which draws the same cog. -->
        <Geometry x:Key="CogGlyph">M5.57,2.31 L5.85,0.50 A6.6,6.6 0 0 1 8.15,0.50 L8.43,2.31 A4.9,4.9 0 0 1 9.30,2.67 L10.79,1.59 A6.6,6.6 0 0 1 12.41,3.21 L11.33,4.70 A4.9,4.9 0 0 1 11.69,5.57 L13.50,5.85 A6.6,6.6 0 0 1 13.50,8.15 L11.69,8.43 A4.9,4.9 0 0 1 11.33,9.30 L12.41,10.79 A6.6,6.6 0 0 1 10.79,12.41 L9.30,11.33 A4.9,4.9 0 0 1 8.43,11.69 L8.15,13.50 A6.6,6.6 0 0 1 5.85,13.50 L5.57,11.69 A4.9,4.9 0 0 1 4.70,11.33 L3.21,12.41 A6.6,6.6 0 0 1 1.59,10.79 L2.67,9.30 A4.9,4.9 0 0 1 2.31,8.43 L0.50,8.15 A6.6,6.6 0 0 1 0.50,5.85 L2.31,5.57 A4.9,4.9 0 0 1 2.67,4.70 L1.59,3.21 A6.6,6.6 0 0 1 3.21,1.59 L4.70,2.67 A4.9,4.9 0 0 1 5.57,2.31 Z M9.20,7.00 A2.2,2.2 0 1 1 4.80,7.00 A2.2,2.2 0 1 1 9.20,7.00 Z</Geometry>
        <Style x:Key="SettingsCogButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, ElementName=SettingsTab}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SelectedTabText}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Text/link-style button used for the click-to-copy system name. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource LinkText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="txt" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                                <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource LinkHoverText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square +/- stepper button. -->
        <Style x:Key="StepperButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource StepperBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource StepperText}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource StepperHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text boxes: WPF's own Aero2 template, copied element for element, so that the blue
             border under the mouse and while typing can follow a role like everything else. In
             the stock template those two blues are fixed brushes nothing outside can reach.
             Only the two brushes differ from the original, and their defaults are the stock
             values, so a text box looks exactly as it always did. Every other setting (focus
             visual, selection colours, scrolling) still comes from the stock style underneath;
             this one only swaps the template. The Needed cell editor further down is based on
             this style, because it is a text box too and showed the same blue while editing.
             It also sets the selection colour (the text box keeps its own 40% opacity, so the
             role's colour is blended exactly as the stock blue was) and the right-click menu
             below, in place of the one the text box builds for itself. -->
        <Style TargetType="TextBox">
            <Setter Property="SelectionBrush" Value="{DynamicResource TextSelection}"/>
            <Setter Property="ContextMenu" Value="{DynamicResource TextBoxMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.56"/>
                            </Trigger>
                            <!-- Same order as the original: focus is listed last, so it wins while
                                 the mouse is also over a box being typed in. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InputHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The text box right-click menu. A text box with no menu of its own builds one when
             right-clicked, but it is an internal WPF type that styles in this window cannot
             reach, so every text box gets this one instead: the same three items, the same
             words, the same shortcuts shown beside them, greyed out by the same rules (they ask
             the text box whether they can run). Not shared (x:Shared), so each text box has its
             own. TextBoxMenu_Opened aims the items at the box that was right-clicked. The colour
             picker's fields use it too when they sit in this window. -->
        <ContextMenu x:Key="TextBoxMenu" x:Shared="False" Opened="TextBoxMenu_Opened">
            <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut"/>
            <MenuItem Header="_Copy" Command="ApplicationCommands.Copy"/>
            <MenuItem Header="_Paste" Command="ApplicationCommands.Paste"/>
        </ContextMenu>

        <!-- Menus: WPF's Aero2 ContextMenu and menu item templates, copied, with every colour
             in them a role. Each default is the colour the stock template draws, so the menu
             looks exactly as it did. The checkmark box of the stock item template is left out
             (nothing here is ever ticked), but an empty box of the same size stays in its place,
             because a hidden element still takes room and the item would be shorter without it. -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource MenuBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <aero2:SystemDropShadowChrome x:Name="Shdw" Color="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="ContextMenuBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="ContextMenuScrollViewer" Grid.ColumnSpan="2" Margin="1,0"
                                              Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type FrameworkElement}, ResourceId=MenuScrollViewer}}">
                                    <Grid RenderOptions.ClearTypeHint="Enabled">
                                        <Canvas Height="0" Width="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Rectangle x:Name="OpaqueRect"
                                                       Height="{Binding ElementName=ContextMenuBorder, Path=ActualHeight}"
                                                       Width="{Binding ElementName=ContextMenuBorder, Path=ActualWidth}"
                                                       Fill="{Binding ElementName=ContextMenuBorder, Path=Background}"/>
                                        </Canvas>
                                        <Rectangle Fill="{DynamicResource MenuGutter}" HorizontalAlignment="Left"
                                                   Width="28" Margin="1,2" RadiusX="2" RadiusY="2"/>
                                        <Rectangle Fill="{DynamicResource MenuGutterLine}" HorizontalAlignment="Left"
                                                   Width="1" Margin="29,2,0,2"/>
                                        <Rectangle Fill="{DynamicResource MenuGutterLineHighlight}" HorizontalAlignment="Left"
                                                   Width="1" Margin="30,2,0,2"/>
                                        <!-- Never drawn: it only carries the shadow role, because the
                                             shadow takes a Color rather than a brush. -->
                                        <Rectangle x:Name="ShadowColour" Fill="{DynamicResource MenuShadow}" Visibility="Collapsed"/>
                                        <ItemsPresenter x:Name="ItemsPresenter" Margin="{TemplateBinding Padding}"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </aero2:SystemDropShadowChrome>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasDropShadow" Value="True">
                                <Setter TargetName="Shdw" Property="Margin" Value="0,0,5,5"/>
                                <Setter TargetName="Shdw" Property="Color" Value="{Binding Fill.Color, ElementName=ShadowColour}"/>
                            </Trigger>
                            <Trigger SourceName="ContextMenuScrollViewer" Property="ScrollViewer.CanContentScroll" Value="False">
                                <Setter TargetName="OpaqueRect" Property="Canvas.Top"
                                        Value="{Binding ElementName=ContextMenuScrollViewer, Path=VerticalOffset}"/>
                                <Setter TargetName="OpaqueRect" Property="Canvas.Left"
                                        Value="{Binding ElementName=ContextMenuScrollViewer, Path=HorizontalOffset}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="templateRoot" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                    <Grid Margin="-1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MinWidth="22" SharedSizeGroup="MenuItemIconColumnGroup" Width="Auto"/>
                                            <ColumnDefinition Width="13"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition SharedSizeGroup="MenuItemIGTColumnGroup" Width="Auto"/>
                                            <ColumnDefinition Width="20"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter x:Name="Icon" ContentSource="Icon" HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" Height="16" Width="16" Margin="3"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        <Border x:Name="GlyphPanel" Width="22" Height="22" Margin="-1,0,0,0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="Hidden" ClipToBounds="False"/>
                                        <ContentPresenter x:Name="menuHeaderContainer" ContentSource="Header" Grid.Column="2"
                                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        <TextBlock x:Name="menuGestureText" Grid.Column="4" Margin="{TemplateBinding Padding}"
                                                   Opacity="0.7" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Icon" Value="{x:Null}">
                                        <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource MenuHighlight}"/>
                                        <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource MenuHighlightBorder}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="templateRoot" Property="TextElement.Foreground" Value="{DynamicResource MenuDisabledText}"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsHighlighted" Value="True"/>
                                            <Condition Property="IsEnabled" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource MenuDisabledHighlight}"/>
                                        <Setter TargetName="templateRoot" Property="BorderBrush" Value="{DynamicResource MenuDisabledHighlightBorder}"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Tooltips: the stock template already draws from these three properties, so setting
             them is all it takes. Styles here do reach tooltips, which open in their own little
             window but look their resources up through the element they belong to. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ToolTipBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolTipText}"/>
        </Style>

        <!-- Dark-theme tabs. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TabText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <!-- BorderThickness starts at 0 (no border) so only the selected trigger's
                             border shows; CornerRadius rounds just the top so the selected tab's
                             flat bottom edge sits flush against the panel below with no border cut
                             at the seam (the panel/content Grid below no longer has a top margin
                             either, so there's no gap - see the tab content Grids). -->
                        <Border x:Name="bd" Background="Transparent" Padding="16,9" Margin="0,0,4,0"
                                CornerRadius="6,6,0,0" BorderThickness="0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedTabBackground}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource SelectedTabOutline}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1,1,1,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectedTabText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <!-- Bound to "bd"'s own IsMouseOver (not the TabItem's ambient one):
                                 the TabItem's IsMouseOver can read true while the pointer is over
                                 the selected tab's page content (e.g. the empty gap between the
                                 two panels on the Modifications/Import tabs), since that content is
                                 hosted by TabControl's own default template, not nested inside this
                                 TabItem's template. Scoping the trigger to "bd" itself (which only
                                 covers the actual header chip) keeps the hover highlight limited to
                                 hovering the tab label, regardless of that ambient bleed. -->
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=bd}" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TabHoverBackground}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Title bar: fills WindowChrome's CaptionHeight strip. Everything in here except the
             three buttons is drag-to-move / double-click-to-maximize for free, since only the
             buttons are marked IsHitTestVisibleInChrome. -->
        <Border DockPanel.Dock="Top" Height="36" Background="{DynamicResource TitleBarBackground}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="Assets/FleetFinderIcon.ico" Width="16" Height="16"/>
                    <TextBlock Text="FleetFinder" Margin="8,0,0,0" FontSize="12"
                               Foreground="{DynamicResource TitleBarText}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentVersionText}" Margin="6,0,0,0" FontSize="10"
                               Foreground="{DynamicResource TitleBarVersion}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                            Click="MinimizeButton_Click" ToolTip="Minimize"
                            AutomationProperties.Name="Minimize"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="10" Height="10" Stretch="None" Data="M0,5.5 H10"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButton}"
                            Click="MaximizeRestoreButton_Click" ToolTip="Maximize"
                            AutomationProperties.Name="Maximize"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="10" Height="10">
                            <Path x:Name="MaximizeIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1"/>
                            <Canvas x:Name="RestoreIcon" Visibility="Collapsed">
                                <Rectangle Canvas.Left="2.5" Canvas.Top="0" Width="7.5" Height="7.5"
                                           Fill="Transparent"
                                           Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                           StrokeThickness="1"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="2.5" Width="7.5" Height="7.5"
                                           Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Background}"
                                           Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                           StrokeThickness="1"/>
                            </Canvas>
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}"
                            Click="CloseButton_Click" ToolTip="Close"
                            AutomationProperties.Name="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="10" Height="10" Stretch="None" Data="M0,0 L10,10 M0,10 L10,0"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.2"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Update banner: dismissible, non-blocking (unlike the resume-search overlay below,
             this never covers the tabs), shown when UpdateChecker finds a newer GitHub release
             than the one currently running. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BannerBackground}" Padding="12,6"
                Visibility="{Binding HasUpdateAvailable, Converter={x:Static local:BoolToVis.Instance}}">
            <Grid>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource BannerText}" FontWeight="SemiBold">
                    <Run Text="A new version ("/><Run Text="{Binding UpdateVersionText, Mode=OneWay}"/><Run Text=") is available."/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Download" Command="{Binding OpenUpdateCommand}"
                            Background="{DynamicResource BannerButtonBackground}" Foreground="{DynamicResource BannerButtonText}" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="Dismiss" Command="{Binding DismissUpdateCommand}"
                            Background="Transparent" Foreground="{DynamicResource BannerText}" BorderThickness="0" Padding="8,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBackground}" Padding="16,8">
            <Grid>
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource StatusText}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding InventoryStatus}" Foreground="{DynamicResource StatusDetailText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Tabs, plus the "resume last search" overlay stacked on top of just this area (title
             bar / status bar stay usable while it's up). -->
        <Grid>
        <TabControl x:Name="MainTabs" Margin="12,8,12,12" Background="Transparent">
        <TabItem Header="Find Carriers">
        <!-- Main split. TextElement.Foreground here (and on each tab's root Grid below) is there
             for the colour changer: a tab's content inherits its text colour from the TabItem,
             so every heading in these panels was orange only because the selected tab's label
             is. Setting PanelText on the root keeps the two separate. Same colour by default. -->
        <Grid TextElement.Foreground="{DynamicResource PanelText}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FindCarriersLeftColumn" Width="380" MinWidth="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: components / shopping list -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Select components to price, or choose a modification in the Modifications tab"
                                       FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Refresh inventory" Command="{Binding RefreshInventoryCommand}"
                                Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}"/>
                        <Button Content="Clear Buy" Command="{Binding ClearBuySelectionCommand}"
                                Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}" Padding="8,4" Margin="8,0,0,0"/>
                        <Button Content="Clear Sell" Command="{Binding ClearSellSelectionCommand}"
                                Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}" Padding="8,4" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Jump-to-match search box: typing scrolls the list to and highlights the
                         first matching component, it does not filter the list - mirrors EDCF's
                         own search box exactly (same property/event names, same behavior). -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Search" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="2,0,0,2"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputText}" BorderBrush="{DynamicResource InputBorder}"
                                 BorderThickness="1" Padding="8,6"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Content="{Binding SearchButtonLabel}"
                                Command="{Binding SearchCommand}" FontSize="14" Padding="12,9"/>
                    </StackPanel>

                    <!-- IsReadOnly="False" overrides the app-wide DataGrid style's IsReadOnly="True" -
                         needed so the Needed column below can be edited, since DataGridColumn.IsReadOnly
                         can only make a column MORE restrictive than the grid, never less (a column-level
                         IsReadOnly="False" cannot re-enable editing on a grid that's itself read-only).
                         Component/Amount below get explicit IsReadOnly="True" to stay locked now that the
                         grid default no longer covers them. -->
                    <DataGrid x:Name="ComponentGrid" ItemsSource="{Binding ComponentsView}" IsReadOnly="False">
                        <!-- Briefly outlines whichever row the search box just jumped to (see
                             ComponentRow.IsHighlighted) - same convention as the results grids'
                             click-to-select outline, reused here for a different trigger (search
                             match, not click). Deliberately no BasedOn - see the DataGridCell
                             gotcha noted elsewhere in this project about BasedOn pulling in the
                             framework's own light-theme default when no app-level implicit style
                             actually exists to inherit from. -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource RowOutline}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.GroupStyle>
                            <!-- Top level: Goods / Assets / Data. -->
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                   Foreground="{DynamicResource GroupHeaderText}"
                                                   Margin="4,8,0,4"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                            <!-- Second level: Chemicals/Circuits/Tech, shown only under Assets -
                                 Data/Goods items have an empty SubCategory, so that (redundant)
                                 sub-header collapses to nothing instead of repeating the group name. -->
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource GroupHeaderText}"
                                                   Margin="16,4,0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <!-- Checkbox column: header border on its right removed so its (empty)
                                 header cell reads as one continuous header with "Component". -->
                            <DataGridTemplateColumn Width="34" CanUserResize="False">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Fills remaining width so no empty "phantom column" filler appears
                                 after Amount. CanUserResize=False since there's nothing to its
                                 right to resize against (Amount is fixed-width), without it, the
                                 column border shows a resize cursor that doesn't do anything. -->
                            <DataGridTextColumn Header="Component" Binding="{Binding Name}" Width="*"
                                                CanUserResize="False" IsReadOnly="True"/>
                            <!-- Every column after Component (the Width="*" one) needs this same
                                 scrollbar-offset compensation, not just whichever happens to be
                                 last: Component's calculated width differs slightly between the
                                 header row and the scrollable body (the body's available width is
                                 narrowed by this grid's custom scrollbar, the header's isn't),
                                 which shifts everything downstream of it by the same amount in
                                 the body relative to the header. See the DataGrid scrollbar
                                 gotcha noted elsewhere in this project. -->
                            <DataGridTextColumn Header="Amount" Binding="{Binding Have}"
                                                Width="Auto" CanUserResize="False" IsReadOnly="True"
                                                HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterText}">
                                        <Setter Property="Margin" Value="0,0,20,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- How many more you still need (Target minus current Have, floored
                                 at 0), set by Apply selected on the Modifications tab or by
                                 importing an EDOMH wishlist. Highlighted orange while > 0 so it's
                                 obvious what's still outstanding; once inventory catches up
                                 (ShipLocker.json refresh sees Have >= Target) the row's own
                                 IsSelected is cleared automatically in MainViewModel, so a repeat
                                 search only looks for what's still actually needed. Also directly
                                 editable (click, then click/double-click/F2 again to type a custom
                                 amount, same as any DataGrid cell - deliberately not a +/- stepper)
                                 for one-off overrides; ComponentRow.StillNeeded's setter back-solves
                                 Target so it stays correct as Have changes, and the next Import or
                                 Modifications Apply naturally overwrites it again. -->
                            <DataGridTextColumn Header="Needed"
                                                Binding="{Binding StillNeeded, Mode=TwoWay}"
                                                Width="Auto" CanUserResize="False" IsReadOnly="False"
                                                HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterText}">
                                        <Setter Property="Margin" Value="0,0,20,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <!-- Based on the window's text box style for its template, so
                                         its hover and focus border follow the text box roles too.
                                         The border is the focus role because that is all it ever
                                         shows: the editor has keyboard focus the whole time it is
                                         open, and the template's focus trigger draws that colour
                                         over whatever BorderBrush says. It had a role of its own
                                         once, which recoloured nothing anyone could see. -->
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource NeededCount}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,20,0"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShort}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource NeededCount}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <!-- Independent of the leading checkbox column (which ticks for
                                 "Where to Buy") - ticking this one searches "Where to Sell"
                                 instead, for carriers currently buying this component from you.
                                 Comes after the Width="*" Component column so it needs the same
                                 scrollbar-offset margin compensation as Amount/Needed above (see
                                 the WPF gotcha noted there - it's not just whichever column is
                                 last). -->
                            <DataGridTemplateColumn Header="Sell" Width="Auto" CanUserResize="False"
                                                    HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding SellSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" Margin="0,0,20,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- RIGHT: carrier results, physically split into two separate bordered panels -
                 "Where to Buy" (top) and "Where to Sell" (bottom) - two independent searches that
                 run at the same time (see MainViewModel.SearchSelectedAsync) driven by the
                 picker's checkbox column and its new Sell column respectively. Each gets its own
                 Border (matching the left/right picker-vs-results split's visual style) rather
                 than sharing one outer Border, specifically so the seam between them reads as an
                 obviously separate, independently-resizable panel rather than one box with an
                 easy-to-miss internal splitter. Kept as two separate DataGrids/panels rather than
                 one grid with a Direction filter, since a carrier can appear in both at once with
                 different commodities and neither list should hide/reorder the other. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Where to Buy" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentSystemLabel}" Foreground="{DynamicResource MutedText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <ProgressBar IsIndeterminate="{Binding IsBuyBusy}" Width="140" Height="6"
                                     Margin="16,0,0,0" Background="{DynamicResource ProgressTrack}" Foreground="{DynamicResource ProgressFill}"
                                     BorderThickness="0"
                                     Visibility="{Binding IsBuyBusy, Converter={x:Static local:BoolToVis.Instance}}"/>
                    </StackPanel>

                    <Grid>
                    <DataGrid ItemsSource="{Binding ListingsView}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              CanUserSortColumns="True"
                              VirtualizingPanel.ScrollUnit="Item"
                              GridLinesVisibility="All"
                              VerticalGridLinesBrush="{DynamicResource GridLines}">
                        <!-- Vertical row breathing room only - horizontal spacing from the column
                             dividers is handled per-column via content Margin instead of Padding
                             here (see CenterTextPadded/VCenterTextPadded above for why). -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Padding" Value="0,4"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <!-- Outlines the row for the fleet carrier currently docked at (per the
                             journal), so it's obvious which result you've actually arrived at. -->
                        <DataGrid.RowStyle>
                            <!-- Deliberately no BasedOn: {StaticResource {x:Type DataGridRow}} resolves to
                                 the framework's own default (light-theme) DataGridRow style, which sets its
                                 own Foreground and overrides the dark-theme color that otherwise inherits
                                 down from the DataGrid's own style - that's what washed the row text out
                                 to a pale grey when this Style was first added. A bare Style with just the
                                 trigger below doesn't touch Foreground/Background at all, so inheritance
                                 (and everything else DataGrid-level, like AlternatingRowBackground) keeps
                                 working exactly as it did with no RowStyle set.

                                 Outlines whichever carrier row you click, so you can browse results and
                                 mark the one you're heading to - stays outlined (native DataGridRow.IsSelected,
                                 SelectionMode=Single from the base DataGrid style) until you click a different
                                 row. The global SystemColors overrides elsewhere in this file suppress the
                                 default blue selection highlight everywhere, so this Setter is the only
                                 visible selection feedback. -->
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource RowOutline}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Every matching commodity this carrier sells, one per line, with how many of
                                 each you still need alongside it. Qty/Price below line up with each commodity
                                 too. Row height grows to fit them all.
                                 Components and Needed are two independent real DataGridColumns (each with its
                                 own ItemsControl) - NOT merged into one. They were merged for a few hours on
                                 2026-07-12 as a sort-speed fix (cutting 4 independent per-item ItemsControls
                                 per row down to 3), then unmerged again the same day after a long, failed
                                 chain of attempts to hand-draw a header divider between the two merged labels
                                 (Stretch alignment, an ancestor-Height binding that hung the UI thread, a
                                 negative-margin bleed proven clipped even at -50px, then a custom header
                                 ControlTemplate that still wasn't reliably reproducing what a real column
                                 boundary gives for free) - a real DataGridColumn boundary gets its divider,
                                 clickability, and correct header/cell alignment from the framework itself,
                                 with zero custom code, which is what these columns actually needed all along.
                                 The sort-speed cost of going back to 4 ItemsControls per row is an accepted
                                 tradeoff versus continuing to fight this. Neither is independently sortable
                                 (CanUserSort="False" on both, same as before the merge) - unlike Qty/Price
                                 below, which keep their own SortMemberPath. -->
                            <DataGridTemplateColumn Header="Components" Width="Auto" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Component}" Margin="7,3"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- How many more you still need (Target minus current Have, floored at 0) -
                                 orange/bold so it's obvious what's still outstanding. -->
                            <DataGridTemplateColumn Header="Needed" Width="Auto" CanUserResize="False" CanUserSort="False"
                                                    HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Needed}" Margin="7,3"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource NeededCount}" FontWeight="Bold"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Carrier names are player-chosen and can run long, so cap the width
                                 (unlike the other columns, which are bounded by our known name lists). -->
                            <DataGridTextColumn Header="Carrier Name" Binding="{Binding StationName}"
                                                Width="Auto" MaxWidth="240" CanUserResize="False"
                                                HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding StationName}"/>
                                        <Setter Property="Margin" Value="7,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Callsign" Binding="{Binding Callsign}"
                                                Width="Auto" CanUserResize="False"
                                                ElementStyle="{StaticResource CenterTextPadded}"
                                                HeaderStyle="{StaticResource CenterHeader}"/>
                            <!-- Docking access: Yes (open) / No (restricted) / Unknown. -->
                            <DataGridTextColumn Header="Access" Binding="{Binding DockingAccess}"
                                                Width="Auto" CanUserResize="False"
                                                ElementStyle="{StaticResource CenterTextPadded}"
                                                HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="0,4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DockingAccess}" Value="Yes">
                                                <Setter Property="Foreground" Value="{DynamicResource GoodValue}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DockingAccess}" Value="No">
                                                <Setter Property="Foreground" Value="{DynamicResource BadValue}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DockingAccess}" Value="Unknown">
                                                <Setter Property="Foreground" Value="{DynamicResource UnknownValue}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <!-- System name: click to copy for pasting into the in-game galaxy map. -->
                            <DataGridTemplateColumn Header="System" Width="Auto" CanUserResize="False"
                                                    SortMemberPath="System"
                                                    HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding System}"
                                                Style="{StaticResource LinkButton}"
                                                ToolTip="Click to copy system name"
                                                Margin="7,0"
                                                Command="{Binding DataContext.CopySystemCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding System}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Qty" Width="Auto" CanUserResize="False"
                                                    SortMemberPath="TotalAmount"
                                                    HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Center">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Amount}" Margin="7,3" TextAlignment="Center"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Price" Width="Auto" CanUserResize="False"
                                                    SortMemberPath="MinPrice"
                                                    HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Center">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} Cr}"
                                                               Margin="7,3" TextAlignment="Center"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dist"
                                                Binding="{Binding DistanceLy, StringFormat={}{0:N0} Ly}"
                                                SortMemberPath="DistanceLy" Width="Auto" CanUserResize="False"
                                                ElementStyle="{StaticResource CenterTextPadded}"
                                                HeaderStyle="{StaticResource CenterHeader}"/>
                            <!-- One value per carrier (freshest of its matching commodities), the update
                                 time reflects the carrier's data snapshot, not any single commodity. -->
                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedText}"
                                                SortMemberPath="MinAge" Width="Auto" CanUserResize="False"
                                                ElementStyle="{StaticResource VCenterTextPadded}"
                                                HeaderStyle="{StaticResource CenterHeader}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No fleet carriers are selling these components."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedText}" FontSize="14" IsHitTestVisible="False"
                               Visibility="{Binding NoResultsFound, Converter={x:Static local:BoolToVis.Instance}}"/>
                    </Grid>
                </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              Background="Transparent"/>

                <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Where to Sell" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentSystemLabel}" Foreground="{DynamicResource MutedText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <ProgressBar IsIndeterminate="{Binding IsSellBusy}" Width="140" Height="6"
                                     Margin="16,0,0,0" Background="{DynamicResource ProgressTrack}" Foreground="{DynamicResource ProgressFill}"
                                     BorderThickness="0"
                                     Visibility="{Binding IsSellBusy, Converter={x:Static local:BoolToVis.Instance}}"/>
                    </StackPanel>

                    <Grid>
                    <DataGrid ItemsSource="{Binding SellListingsView}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              CanUserSortColumns="True"
                              VirtualizingPanel.ScrollUnit="Item"
                              GridLinesVisibility="All"
                              VerticalGridLinesBrush="{DynamicResource GridLines}">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Padding" Value="0,4"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <!-- Same rationale as the "Where to Buy" grid's RowStyle above: no
                                 BasedOn, so it doesn't pull in the framework's light-theme default
                                 and wash out the row text. -->
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource RowOutline}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <!-- Every matching commodity this carrier buys, one per line, with how many of
                                 each you currently Have alongside it. Have is shown here instead of Needed
                                 since selling has no "still need" concept. Components and Have are two
                                 independent real DataGridColumns, not merged - see the matching comment on
                                 the buy grid's Components+Needed columns for why (a long failed chain of
                                 attempts to hand-draw a divider between two merged labels, abandoned in
                                 favor of just using real columns, which get a divider for free). -->
                            <DataGridTemplateColumn Header="Components" Width="Auto" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Component}" Margin="7,3"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Have" Width="Auto" CanUserResize="False" CanUserSort="False"
                                                    HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Have}" Margin="7,3"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource HaveCount}" FontWeight="Bold"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Carrier Name" Binding="{Binding StationName}"
                                                Width="Auto" MaxWidth="240" CanUserResize="False"
                                                HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding StationName}"/>
                                        <Setter Property="Margin" Value="7,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Callsign" Binding="{Binding Callsign}"
                                                Width="Auto" CanUserResize="False"
                                                ElementStyle="{StaticResource CenterTextPadded}"
                                                HeaderStyle="{StaticResource CenterHeader}"/>
                            <DataGridTextColumn Header="Access" Binding="{Binding DockingAccess}"
                                                Width="Auto" CanUserResize="False"
                                                ElementStyle="{StaticResource CenterTextPadded}"
                                                HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="0,4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DockingAccess}" Value="Yes">
                                                <Setter Property="Foreground" Value="{DynamicResource GoodValue}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DockingAccess}" Value="No">
                                                <Setter Property="Foreground" Value="{DynamicResource BadValue}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DockingAccess}" Value="Unknown">
                                                <Setter Property="Foreground" Value="{DynamicResource UnknownValue}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="System" Width="Auto" CanUserResize="False"
                                                    SortMemberPath="System"
                                                    HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding System}"
                                                Style="{StaticResource LinkButton}"
                                                ToolTip="Click to copy system name"
                                                Margin="7,0"
                                                Command="{Binding DataContext.CopySystemCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding System}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Demand: how many units this carrier wants to buy from you. -->
                            <DataGridTemplateColumn Header="Demand" Width="Auto" CanUserResize="False"
                                                    SortMemberPath="TotalAmount"
                                                    HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Center">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Amount}" Margin="7,3" TextAlignment="Center"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Price this carrier pays per unit. -->
                            <DataGridTemplateColumn Header="Price" Width="Auto" CanUserResize="False"
                                                    SortMemberPath="MinPrice"
                                                    HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Center">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} Cr}"
                                                               Margin="7,3" TextAlignment="Center"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dist"
                                                Binding="{Binding DistanceLy, StringFormat={}{0:N0} Ly}"
                                                SortMemberPath="DistanceLy" Width="Auto" CanUserResize="False"
                                                ElementStyle="{StaticResource CenterTextPadded}"
                                                HeaderStyle="{StaticResource CenterHeader}"/>
                            <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedText}"
                                                SortMemberPath="MinAge" Width="Auto" CanUserResize="False"
                                                ElementStyle="{StaticResource VCenterTextPadded}"
                                                HeaderStyle="{StaticResource CenterHeader}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="No fleet carriers are buying these components."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedText}" FontSize="14" IsHitTestVisible="False"
                               Visibility="{Binding NoSellResultsFound, Converter={x:Static local:BoolToVis.Instance}}"/>
                    </Grid>
                </DockPanel>
                </Border>
            </Grid>
        </Grid>
        </TabItem>

        <TabItem Header="Modifications">
            <Grid TextElement.Foreground="{DynamicResource PanelText}">
                <Grid.ColumnDefinitions>
                    <!-- Sized generously by default so full modification names show untruncated,
                         but resizable (drag the splitter) same as the Find Carriers tab. -->
                    <ColumnDefinition x:Name="ModificationsLeftColumn" Width="520" MinWidth="300"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: modification picker -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Suit &amp; weapon modifications" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Foreground="{DynamicResource MutedText}" Margin="0,2,0,0"
                                       Text="Tick the mods you want."/>
                            <TextBlock Text="{Binding ModSelectionSummary}" Foreground="{DynamicResource SummaryText}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Clear selection" Command="{Binding ClearModSelectionCommand}"
                                    Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}" Padding="8,4"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="Apply selected"
                                    Command="{Binding ApplyModTargetsCommand}" FontSize="14" Padding="12,9"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding ModificationsView}"
                                  SelectedItem="{Binding SelectedModification}">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                       Foreground="{DynamicResource GroupHeaderText}" Margin="4,8,0,4"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="34" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Panel is fixed-width and sized generously, so full names show untruncated. -->
                                <DataGridTextColumn Header="Modification" Binding="{Binding Name}"
                                                    Width="Auto" CanUserResize="False">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="0,0,7,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- Quantity with -/+ steppers: how many of this mod you want. Right margin
                                     compensates for this grid's custom (narrower-than-system) scrollbar, which
                                     otherwise desyncs body-column centering from the header, see the DataGrid
                                     scrollbar gotcha noted elsewhere in this project. -->
                                <DataGridTemplateColumn Header="Qty" Width="96" CanUserResize="False"
                                                        HeaderStyle="{StaticResource CenterHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        Margin="0,0,10,0">
                                                <Button Content="−" Style="{StaticResource StepperButton}"
                                                        Command="{Binding DecQuantityCommand}"/>
                                                <TextBlock Text="{Binding Quantity}" MinWidth="26" TextAlignment="Center"
                                                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                <Button Content="+" Style="{StaticResource StepperButton}"
                                                        Command="{Binding IncQuantityCommand}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              Background="Transparent"/>

                <!-- RIGHT: clicked mod (top, fixed to 5 rows, the max a mod ever needs) + pinned totals (bottom) -->
                <Border Grid.Column="2" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                        </Grid.RowDefinitions>

                        <!-- TOP: the modification you clicked (Required scales with its Qty) -->
                        <DockPanel Grid.Row="0">
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="SemiBold" FontSize="14"
                                       Text="{Binding SelectedRequirementsHeader}"/>
                            <!-- Fixed to 5 rows: the maximum commodities any single modification needs. -->
                            <DataGrid ItemsSource="{Binding SelectedRequirements}" Height="148">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Commodity" Binding="{Binding Commodity}" Width="*"/>
                                    <DataGridTextColumn Header="Required" Binding="{Binding Required}" Width="75"
                                                        ElementStyle="{StaticResource CenterText}"
                                                        HeaderStyle="{StaticResource CenterHeader}"/>
                                    <DataGridTextColumn Header="Have" Binding="{Binding Have}" Width="60"
                                                        ElementStyle="{StaticResource CenterText}"
                                                        HeaderStyle="{StaticResource CenterHeader}"/>
                                    <DataGridTextColumn Header="Need" Binding="{Binding Short}" Width="60"
                                                        ElementStyle="{StaticResource CenterText}"
                                                        HeaderStyle="{StaticResource CenterHeader}">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Owned}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource NeededCount}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- Static divider (no longer a draggable splitter, both panes are fixed/auto sized). -->
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource Divider}" Margin="0,10"/>

                        <!-- BOTTOM: total of every commodity needed across all checked modifications. -->
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontWeight="SemiBold" FontSize="14"
                                       Text="Total"/>
                            <DataGrid ItemsSource="{Binding PinnedRequirementsView}"
                                      VirtualizingPanel.ScrollUnit="Item">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Commodity" Binding="{Binding Commodity}" Width="*"/>
                                    <DataGridTextColumn Header="Required" Binding="{Binding Required}" Width="75"
                                                        ElementStyle="{StaticResource CenterText}"
                                                        HeaderStyle="{StaticResource CenterHeader}"/>
                                    <DataGridTextColumn Header="Have" Binding="{Binding Have}" Width="60"
                                                        ElementStyle="{StaticResource CenterText}"
                                                        HeaderStyle="{StaticResource CenterHeader}"/>
                                    <DataGridTextColumn Header="Need" Binding="{Binding Short}" Width="60"
                                                        ElementStyle="{StaticResource CenterText}"
                                                        HeaderStyle="{StaticResource CenterHeader}">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Owned}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource NeededCount}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="Barter">
            <Grid TextElement.Foreground="{DynamicResource PanelText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BarterLeftColumn" Width="340" MinWidth="300"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: running totals -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Bartender calculator" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Foreground="{DynamicResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="14"
                                       Text="Only Chemicals, Circuits and Tech can be bartered - trading only happens within one of these three groups at a time. Click an item on the right to set it as what you want, then set how many of the others to trade in. Picking a want item from a different group clears any amounts set in the previous one, since those points couldn't actually be spent on it."/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button Content="Clear amounts" Command="{Binding ClearBarterCommand}"
                                    Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}" Padding="8,4" FontSize="14"/>
                        </StackPanel>

                        <!-- Running totals for whatever's currently ticked in the grid on the right. -->
                        <Border Background="{DynamicResource TotalsBoxBackground}" BorderBrush="{DynamicResource TotalsBoxBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource MutedText}" FontSize="12" Text="YOU WANT"/>
                                <TextBlock Margin="0,2,0,14" FontSize="16" FontWeight="SemiBold">
                                    <Run Text="{Binding SelectedBarterWant.Row.Name, Mode=OneWay, FallbackValue='(click an item)'}"/>
                                    <Run Text=" (value "/><Run Text="{Binding BarterWantValue, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>

                                <TextBlock Foreground="{DynamicResource MutedText}" FontSize="12" Text="TOTAL POINTS OFFERED"/>
                                <TextBlock Margin="0,2,0,14" FontSize="16" FontWeight="SemiBold"
                                           Text="{Binding BarterTotalPoints, Mode=OneWay}"/>

                                <TextBlock Foreground="{DynamicResource MutedText}" FontSize="12" Text="YOU COULD ACQUIRE"/>
                                <TextBlock Margin="0,2,0,14" FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource BarterResult}">
                                    <Run Text="{Binding BarterAcquirableUnits, Mode=OneWay}"/><Run Text=" unit(s)"/>
                                </TextBlock>

                                <TextBlock Foreground="{DynamicResource MutedText}" FontSize="12" Text="POINTS WASTED IF YOU TRADE NOW"/>
                                <TextBlock Margin="0,2,0,0" FontSize="16"
                                           Text="{Binding BarterLeftoverPoints, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              Background="Transparent"/>

                <!-- RIGHT: every barterable item, grouped by subcategory - click a row to set it
                     as what you want (reuses the same click-to-select-and-outline pattern as the
                     results grids), and use the +/- stepper on any row to set how many to trade
                     in. FontSize is bumped a step above the app default (13) for readability -
                     cascades to the column headers and group headers too since neither sets its
                     own size. -->
                <Border Grid.Column="2" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding BarterGiveRowsView}"
                              SelectedItem="{Binding SelectedBarterWant}"
                              VirtualizingPanel.ScrollUnit="Item"
                              FontSize="15">
                        <DataGrid.GroupStyle>
                            <!-- Same styling as the Find Carriers picker's Chemicals/Circuits/Tech
                                 sub-group headers. -->
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                   Foreground="{DynamicResource GroupHeaderText}"
                                                   Margin="4,8,0,4"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.RowStyle>
                            <!-- Deliberately no BasedOn - see the matching comment on the Where to
                                 Buy grid's RowStyle for why. Outlines whichever row is currently
                                 the "want" item. -->
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource RowOutline}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Component" Binding="{Binding Row.Name}"
                                                Width="*" CanUserResize="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="7,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Buy" Binding="{Binding BuyValue}"
                                                Width="Auto" CanUserResize="False"
                                                ElementStyle="{StaticResource CenterTextPadded}"
                                                HeaderStyle="{StaticResource CenterHeader}"/>
                            <DataGridTextColumn Header="Sell" Binding="{Binding SellValue}"
                                                Width="Auto" CanUserResize="False"
                                                ElementStyle="{StaticResource CenterTextPadded}"
                                                HeaderStyle="{StaticResource CenterHeader}"/>
                            <DataGridTextColumn Header="Credit" Binding="{Binding CreditValue}"
                                                Width="Auto" CanUserResize="False"
                                                ElementStyle="{StaticResource CenterTextPadded}"
                                                HeaderStyle="{StaticResource CenterHeader}"/>
                            <DataGridTextColumn Header="Have" Binding="{Binding Row.Have}"
                                                Width="Auto" CanUserResize="False"
                                                ElementStyle="{StaticResource CenterTextPadded}"
                                                HeaderStyle="{StaticResource CenterHeader}"/>
                            <!-- How many of this item to trade in, 0 to however many you hold. -->
                            <DataGridTemplateColumn Header="Give" Width="120" CanUserResize="False"
                                                    HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    Margin="0,0,10,0">
                                            <Button Content="−" Style="{StaticResource StepperButton}"
                                                    Command="{Binding DecGiveCommand}"/>
                                            <TextBlock Text="{Binding GiveAmount}" MinWidth="30" TextAlignment="Center"
                                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <Button Content="+" Style="{StaticResource StepperButton}"
                                                    Command="{Binding IncGiveCommand}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Points" Binding="{Binding PointsContributed}"
                                                Width="Auto" CanUserResize="False"
                                                ElementStyle="{StaticResource CenterTextPadded}"
                                                HeaderStyle="{StaticResource CenterHeader}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="Foreground" Value="{DynamicResource BarterPoints}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </TabItem>

        <!-- Ship Locker: everything the commander of the latest login has in the ship locker, in
             four cards. The view model reads it off the UI thread and follows the game on the
             same poll as Find Carriers. No splitter, so nothing for window-state.json. -->
        <TabItem Header="Ship Locker">
            <Grid TextElement.Foreground="{DynamicResource PanelText}" DataContext="{Binding ShipLocker}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP: whose locker and when, the filter, and the totals. -->
                <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontSize="14" TextTrimming="CharacterEllipsis"><Run
                                Text="{Binding CommanderText, Mode=OneWay}" FontWeight="SemiBold"/><Run
                                Text="{Binding AsOfText, Mode=OneWay}" Foreground="{DynamicResource MutedText}"/></TextBlock>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Filter" Foreground="{DynamicResource MutedText}"
                                       VerticalAlignment="Center" Margin="2,0,8,0"/>
                            <TextBox x:Name="ShipLockerFilter" DockPanel.Dock="Left" Width="260"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Filter the ship locker"
                                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputText}" BorderBrush="{DynamicResource InputBorder}"
                                     BorderThickness="1" Padding="8,6" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedText}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- The four cards, equal width and the full height left, 6 apart like the panels
                     on the other tabs (the -3 and 3 margins make the gaps without an edge gap). -->
                <ItemsControl x:Name="ShipLockerCards" Grid.Row="2" ItemsSource="{Binding Cards}" Margin="-3,0"
                              Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3,0" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding HeldText}"
                                                   Foreground="{DynamicResource MutedText}" VerticalAlignment="Bottom" Margin="8,0,2,1"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <Grid>
                                        <DataGrid ItemsSource="{Binding Rows}" AutomationProperties.Name="{Binding Title}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"
                                                                    ElementStyle="{StaticResource ItemTextPadded}"/>
                                                <DataGridTextColumn Header="Count" Binding="{Binding Count, StringFormat={}{0:N0}}" Width="Auto"
                                                                    MinWidth="64"
                                                                    ElementStyle="{StaticResource RightTextPadded}"
                                                                    HeaderStyle="{StaticResource RightHeader}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource MutedText}"
                                                   TextWrapping="Wrap" TextAlignment="Center" Margin="12,48,12,0"
                                                   VerticalAlignment="Top" IsHitTestVisible="False"
                                                   Visibility="{Binding IsEmpty, Converter={x:Static local:BoolToVis.Instance}}"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </TabItem>

        <TabItem Header="Import">
            <Grid TextElement.Foreground="{DynamicResource PanelText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ImportLeftColumn" Width="520" MinWidth="300"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: paste or load an EDOMH wishlist export -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Import EDOMH wishlist" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Foreground="{DynamicResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Export a wishlist from Elite Dangerous Odyssey Materials Helper, then paste it below or load the .txt file."/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Load .txt file…" Command="{Binding BrowseImportFileCommand}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Clear" Command="{Binding ClearImportCommand}"
                                    Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}" Padding="8,4"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="Import wishlist"
                                    Command="{Binding ImportWishlistCommand}" FontSize="14" Padding="12,9"/>
                        </StackPanel>

                        <TextBox Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="12"
                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputText}" BorderBrush="{DynamicResource InputBorder}"
                                 BorderThickness="1" Padding="6"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              Background="Transparent"/>

                <!-- RIGHT: what got parsed, so an unmatched/mistyped material name is easy to spot -->
                <Border Grid.Column="2" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="SemiBold" FontSize="14"
                                   Text="Parsed items"/>
                        <DataGrid ItemsSource="{Binding ImportPreview}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="*"/>
                                <DataGridTextColumn Header="Required" Binding="{Binding Required}" Width="75"
                                                    ElementStyle="{StaticResource CenterText}"
                                                    HeaderStyle="{StaticResource CenterHeader}"/>
                                <DataGridTextColumn Header="Need" Binding="{Binding Need}" Width="60"
                                                    ElementStyle="{StaticResource CenterText}"
                                                    HeaderStyle="{StaticResource CenterHeader}"/>
                                <DataGridTextColumn Header="Matched" Binding="{Binding Matched}" Width="75"
                                                    ElementStyle="{StaticResource CenterText}"
                                                    HeaderStyle="{StaticResource CenterHeader}">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Matched}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource UnmatchedText}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- Settings: a tab with no header of its own. The cog below selects it, and clicking any
             other tab leaves it, the same as switching between the others. Collapsed, so the strip
             lays out the other tabs exactly as before and Ctrl+Tab passes over it. Its page sets
             PanelText on its own root, as the tabs above do. -->
        <TabItem x:Name="SettingsTab" Header="Settings" Visibility="Collapsed">
            <settings:SettingsPage x:Name="SettingsView"/>
        </TabItem>
        </TabControl>

        <!-- The settings cog, at the right end of the tab strip, level with the tabs and just
             above the panels' right edge (12 of the tab control's margin and 2 of its padding).
             It sits over the tab control rather than in it, so the tabs are untouched, and
             under the resume prompt below, which covers it like everything else. -->
        <Button x:Name="SettingsCogButton" Style="{StaticResource SettingsCogButton}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,11,14,0"
                Click="SettingsCogButton_Click" ToolTip="Settings" AutomationProperties.Name="Settings">
            <Path Width="14" Height="14" Stretch="None" StrokeThickness="1" Data="{StaticResource CogGlyph}"
                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
        </Button>

        <!-- "Resume last search" overlay: shown when a targeted search (Modifications/Import)
             was left with components still short at the app's last close. Background is a real
             (semi-transparent) brush, not Transparent, so it also blocks clicks to the tabs
             underneath while up. -->
        <Border Background="{DynamicResource OverlayDim}"
                Visibility="{Binding HasPendingSearchPrompt, Converter={x:Static local:BoolToVis.Instance}}">
            <Border Background="{DynamicResource DialogBackground}" BorderBrush="{DynamicResource DialogBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="24" MaxWidth="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Unfinished search" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource DialogTitle}" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="You didn't complete your last search. Would you like to continue or start a new search?"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Continue" Command="{Binding ContinuePendingSearchCommand}"
                                Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Start New" Command="{Binding StartNewSearchCommand}"
                                Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        </Grid>
    </DockPanel>
</Window>
