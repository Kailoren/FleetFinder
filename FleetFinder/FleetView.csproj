<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>FleetFinder</ApplicationTitle>
    <AssemblyName>FleetFinder</AssemblyName>
    <RootNamespace>FleetView</RootNamespace>
    <ApplicationIcon>Assets\FleetFinderIcon.ico</ApplicationIcon>
    <Version>2.2.10</Version>
  </PropertyGroup>

  <!--
    How this app is published, stated here rather than left to whoever types the command.

    These only take effect on publish, so a normal build is unaffected. They live here because
    forgetting one of them does not fail: it produces an exe that looks finished and is not.
    IncludeNativeLibrariesForSelfExtract was missed on a rebuild in September 2026, which left
    WPF's five native DLLs (PresentationNative_cor3, wpfgfx_cor3, D3DCompiler_47_cor3, PenImc_cor3,
    vcruntime140_cor3) sitting beside the exe instead of inside it. The publish step copies the exe
    and the Data folder and nothing else, so those DLLs never reached the install and the app died
    with DllNotFoundException the moment WPF created its first window - eight megabytes smaller and
    no crash log, because the failure is inside a native window procedure where nothing managed can
    catch it.

    RuntimeIdentifier is deliberately NOT set here. SelfContained without one fails the publish
    loudly, which is the right outcome; pinning it would also make every ordinary build
    RID-specific for no benefit.
  -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- No .pdb in a published build. Symbols carry the build machine's source paths, local
         variable names and line numbers, none of which a downloaded release needs. Debug builds
         keep theirs. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Component reference data ships next to the exe and can be edited without a rebuild. -->
    <None Update="Data\catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <None Update="Data\modifications.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!--
    Puts the two reference files back after publishing.

    Publishing a second time into a folder that already holds a publish deleted both of them, and
    the app then failed at launch with "Component catalog not found" - an exe shipped with no
    catalog beside it. The cause is an interaction between single-file publishing and incremental
    build: GenerateSingleFileBundle is skipped when its outputs are up to date, which drops these
    files out of ResolvedFileToPublish, and the SDK then removes them from the publish folder as
    output that is no longer produced. Nothing else in the folder is touched, which is what makes
    it easy to miss - the app looks published and the user's saved state is all still there.

    CopyToPublishDirectory=Always above is correct but does not fix it on its own, because the
    target that would act on it never runs. Copying afterwards does not depend on any of that
    being true, which is the point: this is the step that decides whether the app can start, and it
    should not be conditional on an incremental check several targets away.
  -->
  <Target Name="EnsureReferenceDataPublished" AfterTargets="Publish">
    <ItemGroup>
      <ReferenceDataToPublish Include="$(MSBuildProjectDirectory)\Data\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(ReferenceDataToPublish)" DestinationFolder="$(PublishDir)Data" />
    <Error Condition="!Exists('$(PublishDir)Data\catalog.json')"
           Text="catalog.json is missing from the publish output; the app would not start." />
  </Target>

  <ItemGroup>
    <!-- Embedded so Window.Icon can reference it by relative pack URI. Also referenced via
         ApplicationIcon above (for the exe's own file icon), it needs to be both a Resource
         item (for runtime use) and an ApplicationIcon (for the file itself). -->
    <Resource Include="Assets\FleetFinderIcon.ico"/>
  </ItemGroup>

  <!--
    Fails the publish if WPF's native libraries ended up beside the exe rather than inside it.

    This is the check that would have caught the September 2026 breakage at build time. It looks at
    the actual output rather than at the property above, so an override on the command line is
    caught too. The app cannot report this itself: the failure happens in a native window
    procedure, so it never reaches the handler that writes the crash log.
  -->
  <Target Name="EnsureSingleFileIsSelfContained" AfterTargets="Publish">
    <ItemGroup>
      <StrayNativeLibrary Include="$(PublishDir)*_cor3.dll" />
    </ItemGroup>
    <Error Condition="'@(StrayNativeLibrary)' != ''"
           Text="Publish left native libraries beside the exe (@(StrayNativeLibrary->'%(Filename)%(Extension)', ', ')). The exe is not self-contained, and publishing copies only the exe and Data, so the app would fail at startup with DllNotFoundException. Publish with IncludeNativeLibrariesForSelfExtract=true." />
  </Target>

</Project>
