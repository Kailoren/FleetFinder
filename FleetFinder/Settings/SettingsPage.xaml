<UserControl x:Class="FleetView.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FleetView.Controls"
             xmlns:settings="clr-namespace:FleetView.Settings"
             TextElement.Foreground="{DynamicResource PanelText}"
             KeyDown="Page_KeyDown" UseLayoutRounding="True">

    <!-- The Settings page, opened by the cog at the right end of the tab strip. Left: every colour
         role as a list, grouped, with Save, Revert and Reset to defaults pinned under it. Right:
         the live preview, which shows the draft. The app itself only changes on Save.

         PanelText on the root, as on every other tab: tab content inherits the selected tab's
         text colour otherwise.

         The colour picker opens on a layer over this page rather than in a WPF Popup. A Popup is
         a window of its own, which would leave it out of the screenshot harness's renders, and the
         layer is also what catches a click anywhere outside the picker to close it. The layer is a
         sibling of the preview, not inside it, so the picker keeps the app's colours while the
         preview shows the draft.

         Layout rounding keeps the preview on whole pixels. Without it the heading above the
         preview leaves it a fraction of a pixel down, and its thin lines (a grid header's bottom
         edge) then draw a shade lighter or darker from one render to the next. -->


    <UserControl.Resources>
        <!-- The colour box: the role's draft colour, outlined like a text box (it is something
             you click to change, as a text box is), and outlined in the typing colour while the
             picker is open on it. -->
        <Style x:Key="ColourBox" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="outline" CornerRadius="3" BorderThickness="1" Padding="2"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <Border CornerRadius="2" Background="{TemplateBinding Background}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outline" Property="BorderBrush" Value="{DynamicResource InputHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="outline" Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter TargetName="outline" Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="Panels">
            <Grid.ColumnDefinitions>
                <!-- Wide enough for the picker to open beside a colour box without reaching the
                     preview. -->
                <ColumnDefinition Width="540"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: the colour list. -->
            <Border x:Name="ListPanel" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Colours" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Foreground="{DynamicResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="13"
                                   FontWeight="Normal"
                                   Text="Click a colour to change it. The preview shows your changes; Save puts them on the whole app. Hover a colour and press Ctrl+C, then Ctrl+V on another to copy it across."/>
                    </StackPanel>

                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SaveButton" Content="Save" Click="Save_Click" Padding="18,7"/>
                            <Button x:Name="RevertButton" Content="Revert" Click="Revert_Click" Margin="8,0,0,0"
                                    Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}"/>
                            <Button x:Name="ResetButton" Content="Reset to defaults" Click="Reset_Click" Margin="8,0,0,0"
                                    Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}"/>
                        </StackPanel>
                        <TextBlock x:Name="FootNote" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="200" TextAlignment="Right" Visibility="Collapsed"/>
                    </Grid>

                    <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="ColourList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type settings:ColourGroup}">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="2,4,0,4"
                                                   Foreground="{DynamicResource GroupHeaderText}"/>
                                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type settings:ColourRow}">
                                                    <!-- The whole row, gaps included, counts as under the mouse for
                                                         Ctrl+C and Ctrl+V, not just the small colour box, so the outer
                                                         border is see-through rather than empty. The inner one outlines
                                                         the row when a click in the preview finds it, drawn like the
                                                         clicked row in a results grid. Margin, border and padding add
                                                         up to the 14,3,10,3 the row always had. -->
                                                    <Border x:Name="RowHit" Background="Transparent"
                                                            MouseEnter="Row_MouseEnter" MouseLeave="Row_MouseLeave">
                                                        <Border x:Name="RowMark" Margin="7,0,3,0" Padding="5,1,5,1" BorderThickness="2"
                                                                CornerRadius="4">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFound}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource RowOutline}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="76"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MainText}"
                                                                               FontWeight="Normal" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource MutedText}"
                                                                               FontWeight="Normal" FontSize="11" TextWrapping="Wrap">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasNote}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Style="{StaticResource ColourBox}" Background="{Binding Swatch}"
                                                                        Click="ColourBox_Click" ToolTip="Change this colour"
                                                                        AutomationProperties.Name="{Binding Label}"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Hex}" Foreground="{DynamicResource MutedText}"
                                                                           FontWeight="Normal" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- RIGHT: the preview, and the saved themes under it. -->
            <Grid x:Name="RightColumn" Grid.Column="2" SizeChanged="RightColumn_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- The preview, scaled to fit and never past its own size: the themes strip takes
                     its height first, and the preview shrinks into what is left. Clicking something
                     in it lights up that thing's rows in the list, and whatever a click would pick
                     is outlined while the mouse is over it. The preview itself never takes the mouse
                     (its buttons and grids would react), so the area round it does, and the outline
                     sits on a layer of its own over it, in the app's colours rather than the draft's. -->
                <Border x:Name="PreviewPanel" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Preview" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <Grid x:Name="PreviewArea" Background="Transparent" Cursor="Hand"
                              MouseMove="PreviewArea_MouseMove" MouseLeave="PreviewArea_MouseLeave"
                              MouseLeftButtonDown="PreviewArea_MouseLeftButtonDown" SizeChanged="PreviewArea_SizeChanged">
                            <Viewbox x:Name="PreviewBox" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"
                                     TextOptions.TextHintingMode="Fixed">
                                <settings:ThemePreview x:Name="Preview"/>
                            </Viewbox>
                            <!-- Marching ants: a light dash over a dark line, so it shows on any colour
                                 the preview has, and stays thin enough not to get in the way. -->
                            <Canvas x:Name="OutlineLayer" IsHitTestVisible="False">
                                <Rectangle x:Name="HoverOutlineBack" Visibility="Collapsed" StrokeThickness="1"
                                           Stroke="{DynamicResource WindowBackground}" SnapsToDevicePixels="True"/>
                                <Rectangle x:Name="HoverOutline" Visibility="Collapsed" StrokeThickness="1" StrokeDashArray="3 3"
                                           Stroke="{DynamicResource MainText}" SnapsToDevicePixels="True"/>
                            </Canvas>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- The themes (C8, D4): a row of small cards that scrolls sideways, each one a
                     picture of the preview in that theme, its name, who made it and Apply. The
                     user's own come first, then the ones FleetFinder comes with, in labelled groups. A saved theme's right-click menu has Copy share code and
                     Delete; a built-in one's has only Copy share code. On a short window the whole
                     strip is scaled down (ThemesScale) so the preview keeps some room. -->
                <Border x:Name="ThemesPanel" Grid.Row="2" Background="{DynamicResource PanelBackground}" CornerRadius="6" Padding="10"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                    <Border.LayoutTransform>
                        <ScaleTransform x:Name="ThemesScale"/>
                    </Border.LayoutTransform>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Themes" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SaveThemeButton" Content="Save as theme" Click="SaveTheme_Click" Padding="12,5"
                                        Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}"/>
                                <Button x:Name="ImportCodeButton" Content="Import code" Click="ImportCode_Click" Padding="12,5" Margin="8,0,0,0"
                                        Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}"/>
                            </StackPanel>
                        </Grid>

                        <!-- One card's height, plus room for the scrollbar, so the strip is the same
                             height whatever it holds and saving the first theme does not shift the
                             preview. -->
                        <ScrollViewer x:Name="CardScroll" Height="{x:Static settings:SettingsPage.CardRowHeight}"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Focusable="False" PreviewMouseWheel="CardScroll_PreviewMouseWheel">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <!-- Where the user's first theme will go, saying so, until there is one.
                                     The size of a card, so the built-in ones after it stay put. -->
                                <Border x:Name="ThemesEmptyTile" Width="178" Height="257" Margin="0,0,10,0" Padding="12" CornerRadius="6"
                                        BorderThickness="1" BorderBrush="{DynamicResource Divider}" Background="Transparent">
                                    <TextBlock x:Name="ThemesEmpty" Foreground="{DynamicResource MutedText}" FontWeight="Normal" FontSize="13"
                                               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                               Text="No saved themes yet. Save your colours as a theme, or import a code someone shared."/>
                                </Border>
                                <ItemsControl x:Name="CardList" Focusable="False" VerticalAlignment="Top">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type settings:ThemeCard}">
                                            <!-- The barter totals box's colours: a tile set into the panel,
                                                 dark in Ali's palette, a white field in the light themes.
                                                 The tooltip has the whole credit, for a name too long for
                                                 the card. -->
                                            <Border x:Name="CardBorder" Width="178" Margin="0,0,10,0" Padding="8" CornerRadius="6" BorderThickness="1"
                                                    Background="{DynamicResource TotalsBoxBackground}" BorderBrush="{DynamicResource TotalsBoxBorder}"
                                                    ToolTip="{Binding Credit}" AutomationProperties.Name="{Binding Credit}">
                                                <Border.ContextMenu>
                                                    <ContextMenu Opened="CardMenu_Opened" Closed="CardMenu_Closed">
                                                        <MenuItem Header="Copy share code" Click="CardCopyCode_Click"/>
                                                        <MenuItem Header="Delete" Click="CardDelete_Click"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <StackPanel>
                                                    <Image Source="{Binding Snapshot}" Width="{x:Static settings:ThemeSnapshot.CardWidth}"
                                                           Height="{x:Static settings:ThemeSnapshot.CardHeight}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <Grid Margin="0,8,0,0">
                                                        <StackPanel x:Name="CardFace">
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MainText}" FontWeight="SemiBold"
                                                                       FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                            <!-- An empty line still takes its height, so every card is the
                                                                 same height whether or not anyone is credited. -->
                                                            <TextBlock Text="{Binding Author}" Foreground="{DynamicResource MutedText}" FontWeight="Normal"
                                                                       FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                            <Button Content="Apply" Click="CardApply_Click" Padding="12,5" Margin="0,8,0,0"
                                                                    HorizontalAlignment="Left" MinWidth="70"/>
                                                        </StackPanel>
                                                        <!-- Delete asks here, on the card, in the face's place. -->
                                                        <StackPanel x:Name="CardConfirm" Visibility="Collapsed">
                                                            <TextBlock Text="Delete this theme?" Foreground="{DynamicResource MainText}" FontWeight="SemiBold"
                                                                       FontSize="13"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,25,0,0">
                                                                <Button x:Name="CardConfirmDeleteButton" Content="Delete" Click="CardConfirmDelete_Click" Padding="12,5"/>
                                                                <Button x:Name="CardKeepButton" Content="Keep" Click="CardKeep_Click" Padding="12,5" Margin="6,0,0,0"
                                                                        Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsConfirmingDelete}" Value="True">
                                                    <Setter TargetName="CardFace" Property="Visibility" Value="Hidden"/>
                                                    <Setter TargetName="CardConfirm" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- FleetFinder's own themes, in groups: each starts with a line down the
                                     card's height and a small label beside it, reading downwards ("Built in"
                                     before FleetFinder Orange, "Powerplay" before the twelve leaders, and a
                                     line alone before the rest). A built-in card is the card above without
                                     Delete: it can be applied and shared, never removed. -->
                                <ItemsControl x:Name="BuiltInList" Focusable="False" VerticalAlignment="Top">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type settings:BuiltInSection}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                <StackPanel x:Name="SectionDivider" Orientation="Horizontal" Height="257" Margin="0,0,10,0" VerticalAlignment="Top">
                                                    <Border Width="1" Background="{DynamicResource Divider}"/>
                                                    <TextBlock x:Name="SectionLabel" Text="{Binding Label}" Foreground="{DynamicResource MutedText}"
                                                               FontWeight="Normal" FontSize="12" Margin="6,4,0,0" VerticalAlignment="Top">
                                                        <TextBlock.LayoutTransform>
                                                            <RotateTransform Angle="90"/>
                                                        </TextBlock.LayoutTransform>
                                                    </TextBlock>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" VerticalAlignment="Top">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type settings:ThemeCard}">
                                                            <Border x:Name="CardBorder" Width="178" Margin="0,0,10,0" Padding="8" CornerRadius="6" BorderThickness="1"
                                                                    Background="{DynamicResource TotalsBoxBackground}" BorderBrush="{DynamicResource TotalsBoxBorder}"
                                                                    ToolTip="{Binding Credit}" AutomationProperties.Name="{Binding Credit}">
                                                                <Border.ContextMenu>
                                                                    <ContextMenu Opened="CardMenu_Opened" Closed="CardMenu_Closed">
                                                                        <MenuItem Header="Copy share code" Click="CardCopyCode_Click"/>
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <StackPanel>
                                                                    <Image Source="{Binding Snapshot}" Width="{x:Static settings:ThemeSnapshot.CardWidth}"
                                                                           Height="{x:Static settings:ThemeSnapshot.CardHeight}" Stretch="Uniform"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    <StackPanel x:Name="CardFace" Margin="0,8,0,0">
                                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MainText}" FontWeight="SemiBold"
                                                                                   FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Text="{Binding Author}" Foreground="{DynamicResource MutedText}" FontWeight="Normal"
                                                                                   FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                                        <Button Content="Apply" Click="CardApply_Click" Padding="12,5" Margin="0,8,0,0"
                                                                                HorizontalAlignment="Left" MinWidth="70"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Label}" Value="">
                                                    <Setter TargetName="SectionLabel" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- The note a hover copy or paste leaves beside the row ("Copied #FF7500"), for a moment.
             Drawn like a tooltip, which is what it is; the mouse goes straight through it. -->
        <Canvas x:Name="NoteLayer" IsHitTestVisible="False">
            <Border x:Name="CopyNote" Visibility="Collapsed" BorderThickness="1" Padding="6,2" CornerRadius="3"
                    Background="{DynamicResource ToolTipBackground}" BorderBrush="{DynamicResource ToolTipBorder}">
                <TextBlock x:Name="CopyNoteText" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource ToolTipText}"/>
            </Border>
        </Canvas>

        <!-- The picker layer: covers the page while the picker is open, so a click anywhere
             outside the card closes it. Transparent, not empty, so that it can be clicked. -->
        <Canvas x:Name="PickerLayer" Background="Transparent" Visibility="Collapsed"
                MouseDown="PickerLayer_MouseDown">
            <Border x:Name="PickerCard" Width="480" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource DialogBackground}" BorderBrush="{DynamicResource DialogBorder}"
                    TextElement.Foreground="{DynamicResource MainText}" TextElement.FontSize="13" TextElement.FontWeight="Normal">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="PickerScale"/>
                </Border.LayoutTransform>
                <StackPanel>
                    <TextBlock x:Name="PickerTitle" Margin="13,10,13,0" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource DialogTitle}"/>
                    <controls:ColourPicker x:Name="Picker"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,12">
                        <Button x:Name="PickerOkButton" Content="OK" MinWidth="76" Click="PickerOk_Click"/>
                        <Button x:Name="PickerCancelButton" Content="Cancel" MinWidth="76" Margin="8,0,0,0" Click="PickerCancel_Click"
                                Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- The theme dialogs (Save as theme, Import code), in the window like the picker, over a
             dimmed page as the resume prompt is. The dimming takes every click, so nothing behind
             can be reached while one is open, and Tab goes round the dialog rather than out of it.
             Enter is Save or Add, Escape is Cancel (Page_KeyDown). -->
        <Grid x:Name="DialogLayer" Background="{DynamicResource OverlayDim}" Visibility="Collapsed">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="DialogScale"/>
            </Grid.LayoutTransform>

            <Border x:Name="SaveThemeCard" Width="420" CornerRadius="8" Padding="24" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle"
                    Background="{DynamicResource DialogBackground}" BorderBrush="{DynamicResource DialogBorder}"
                    TextElement.Foreground="{DynamicResource MainText}" TextElement.FontSize="13" TextElement.FontWeight="Normal">
                <StackPanel>
                    <TextBlock Text="Save as theme" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource DialogTitle}"/>
                    <TextBlock Margin="0,4,0,14" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"
                               Text="Saves the colours the preview shows, with a picture of it."/>
                    <TextBlock Text="Name" Margin="0,0,0,4"/>
                    <TextBox x:Name="ThemeNameBox" Padding="8,6" BorderThickness="1" TextChanged="ThemeNameBox_TextChanged"
                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputText}" BorderBrush="{DynamicResource InputBorder}"
                             AutomationProperties.Name="Theme name"/>
                    <TextBlock Text="CMDR" Margin="0,12,0,4"/>
                    <TextBox x:Name="ThemeCommanderBox" Padding="8,6" BorderThickness="1" TextChanged="ThemeCommanderBox_TextChanged"
                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputText}" BorderBrush="{DynamicResource InputBorder}"
                             AutomationProperties.Name="Commander name"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedText}" FontSize="12" TextWrapping="Wrap"
                               Text="The credit people see when they import it. Leave it empty for none."/>
                    <TextBlock x:Name="SaveThemeMessage" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button x:Name="SaveThemeOkButton" Content="Save" MinWidth="76" Click="SaveThemeOk_Click"/>
                        <Button x:Name="SaveThemeCancelButton" Content="Cancel" MinWidth="76" Margin="8,0,0,0" Click="DialogCancel_Click"
                                Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The code box takes Enter for Add rather than a new line (ImportCodeBox_PreviewKeyDown),
                 but accepts line breaks in what is pasted, so a whole Discord message can go in. -->
            <Border x:Name="ImportCard" Width="460" CornerRadius="8" Padding="24" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle"
                    Background="{DynamicResource DialogBackground}" BorderBrush="{DynamicResource DialogBorder}"
                    TextElement.Foreground="{DynamicResource MainText}" TextElement.FontSize="13" TextElement.FontWeight="Normal">
                <StackPanel>
                    <TextBlock Text="Import code" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource DialogTitle}"/>
                    <TextBlock Margin="0,4,0,14" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"
                               Text="Paste a theme code someone shared. You can see the theme here before adding it."/>
                    <TextBox x:Name="ImportCodeBox" MinHeight="58" MaxHeight="130" Padding="8,6" BorderThickness="1" TextWrapping="Wrap" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="12" TextChanged="ImportCodeBox_TextChanged" PreviewKeyDown="ImportCodeBox_PreviewKeyDown"
                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputText}" BorderBrush="{DynamicResource InputBorder}"
                             AutomationProperties.Name="Theme code"/>
                    <TextBlock x:Name="ImportMessage" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ImportFound" Margin="0,14,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                        <Border BorderThickness="1" BorderBrush="{DynamicResource Divider}" HorizontalAlignment="Center">
                            <Image x:Name="ImportImage" Width="{x:Static settings:ThemeSnapshot.ImportWidth}"
                                   Height="{x:Static settings:ThemeSnapshot.ImportHeight}" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock x:Name="ImportCredit" Margin="0,8,0,0" FontWeight="SemiBold" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="400"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button x:Name="ImportAddButton" Content="Add to my themes" MinWidth="76" Click="ImportAdd_Click"/>
                        <Button x:Name="ImportCancelButton" Content="Cancel" MinWidth="76" Margin="8,0,0,0" Click="DialogCancel_Click"
                                Background="{DynamicResource SecondaryButtonBackground}" Foreground="{DynamicResource SecondaryButtonText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Where a theme's picture is drawn when there is no preview showing it: a second preview,
             made when first needed, laid out at full size inside a box of no size, so it never
             shows. It sits in the page so the window's styles reach it, as they reach the real one. -->
        <Canvas x:Name="SnapshotHost" Width="0" Height="0" ClipToBounds="True" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="False"/>
    </Grid>
</UserControl>
