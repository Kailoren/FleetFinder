<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FleetView.Relay</RootNamespace>
    <AssemblyName>FleetView.Relay</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- No debug symbols in the production artifact - this deploys straight to an internet-facing
       server, so there's no reason to ship a .pdb there. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetMQ" Version="4.0.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Pinned directly because Microsoft.Data.Sqlite 10.0.10 pulled SQLitePCLRaw.lib.e_sqlite3
         2.1.11, which bundles a SQLite build affected by CVE-2025-6965 (GHSA-2m69-gcr7-jv3q,
         memory corruption when aggregate terms exceed available columns, fixed upstream in SQLite
         3.50.2). 10.0.12 pulls 2.1.12 instead, which is not flagged, but the pin stays: 3.53.3 is
         newer still and is the native build the live relay has run since July. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mirrors FleetFinder/Data/catalog.json - used only to resolve a normalized component key
         back to its human-readable display name for the /listings response (EDDN's own FCMaterials
         messages carry unlocalised internal keys, not display strings). Keep in sync manually if
         FleetFinder's catalog changes; copy again with `Copy-Item` from that path. -->
    <None Update="Data\catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
